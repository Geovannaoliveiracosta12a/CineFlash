{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "index.js"
        },
        {
            "src": "/todos-filmes",
            "dest": "index.js"
        },
        {
            "src": "/create-filmes",
            "dest": "index.js"
        },
        {
            "src": "/delete-filmes/(.*)",
            "dest": "index.js"
        },
        {
            "src": "/update-filmes/(.*)",
            "dest": "index.js"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/$1"
        }
    ]
}